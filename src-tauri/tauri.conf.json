{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parchment",
  "version": "1.3.0",
  "identifier": "local.parchment.reader",
  "build": {
    "frontendDist": "../renderer-tauri"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: http://asset.localhost data: https:; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Markdown reader",
    "longDescription": "Local Markdown reader",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown document",
        "description": "Markdown document",
        "role": "Viewer",
        "mimeType": "text/markdown"
      }
    ],
    "linux": {
      "deb": { "desktopTemplate": "parchment.desktop" },
      "rpm": { "desktopTemplate": "parchment.desktop" }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
